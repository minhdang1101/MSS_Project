POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
# Host port for the PostgreSQL container. Use 5433 if PostgreSQL is already installed on your machine (port 5432).
POSTGRES_PORT=5432
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ===== Only needed for "docker compose --profile app up" (services in containers) =====
# Shared by member-service (signs tokens) and api-gateway (verifies them). At least 32 characters, keep it secret.
JWT_SECRET=change_me_to_a_random_string_of_at_least_32_chars
# Password of the first librarian TT-0001, created when the librarian table is empty
LIBRARIAN_PASSWORD=change_me
# loan-service due-date scan (Spring cron: sec min hour day month weekday). Default: 08:00 every day.
# For a demo, "0 */2 * * * *" runs it every 2 minutes.
LOAN_DUE_SCAN_CRON=0 0 8 * * *
# How often notification-service sends PENDING notifications (ms)
NOTIFICATION_DISPATCH_INTERVAL_MS=15000
