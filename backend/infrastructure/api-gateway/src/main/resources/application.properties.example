spring.application.name=api-gateway
server.port=8080

eureka.client.service-url.defaultZone=http://localhost:8761/eureka/

# ===== JWT do Keycloak cấp (RS256): Gateway chỉ cần khóa công khai, không có secret nào =====
# jwk-set-uri: nơi tải khóa công khai (địa chỉ Gateway gọi tới Keycloak)
app.security.jwt.jwk-set-uri=http://localhost:8180/realms/library/protocol/openid-connect/certs
# issuer-uri: giá trị claim iss trong token, đúng như địa chỉ trình duyệt dùng để đăng nhập
app.security.jwt.issuer-uri=http://localhost:8180/realms/library
app.security.enabled=true

# ===== CORS (React dev server) =====
app.cors.allowed-origins=http://localhost:5173

# ===== Routes: khai báo trong code Java (fu.dlms.gateway.config.GatewayRoutesConfig), không cần ở đây =====

management.endpoints.web.exposure.include=health,info,gateway

