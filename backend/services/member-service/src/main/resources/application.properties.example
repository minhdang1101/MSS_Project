spring.application.name=member-service
server.port=8082

# ===== PostgreSQL (member_db) =====
spring.datasource.url=jdbc:postgresql://localhost:5432/member_db
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password
spring.datasource.driver-class-name=org.postgresql.Driver

# ===== JPA =====
# 'update' is for early development only - switch to Flyway + 'validate' before release
spring.jpa.hibernate.ddl-auto=update
spring.jpa.open-in-view=false
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

# ===== Eureka =====
eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.instance.prefer-ip-address=true

# ===== Actuator =====
management.endpoints.web.exposure.include=health,info

# ===== JWT (must match the api-gateway secret, >= 32 chars) =====
app.security.jwt.secret=your_jwt_secret_at_least_32_characters
app.security.jwt.expiration-minutes=480

# ===== First librarian, created only when the librarian table is empty (leave password empty to skip) =====
app.bootstrap.librarian.staff-code=TT-0001
app.bootstrap.librarian.full-name=Thu thu mac dinh
app.bootstrap.librarian.password=change_me_before_first_run

# ===== Excel import =====
spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=2MB
